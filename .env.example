# BlindSpot configuration.
# Copy to `.env` and adjust. Every value below is a default — BlindSpot runs
# with no .env file at all, fully locally and with no external services.
#
# NEVER commit a real API key.

# ---------------------------------------------------------------- server
BLINDSPOT_HOST=127.0.0.1
BLINDSPOT_PORT=8000
BLINDSPOT_LOG_LEVEL=INFO
# Emit one JSON object per log line instead of human-readable output.
BLINDSPOT_LOG_JSON=false

# ---------------------------------------------------------------- storage
# Left commented on purpose. By default BlindSpot stores everything under
# <project root>/data, which is correct no matter where you launch uvicorn from.
# Setting a *relative* path here resolves against the working directory instead,
# so running from backend/ would silently create a second database.
# Use absolute paths if you override these.
# BLINDSPOT_DATABASE_URL=sqlite:////absolute/path/to/blindspot.db
# BLINDSPOT_INDEX_PATH=/absolute/path/to/index

# ---------------------------------------------------------------- AI providers
# "none" keeps BlindSpot entirely offline and deterministic. This is the default
# and every feature works without an LLM — the model only enriches wording and
# fills gaps the deterministic extractor missed.
#
# Set to "anthropic", "openai", "gemini" or "openrouter" to enable external AI.
# When enabled, only normalised test metadata and incident text are sent. Source
# code and raw test bodies are never transmitted, and the UI shows that external
# AI is active.
#
# The model never changes a verdict. It can identify a feature the rules could
# not, and it rewrites the explanation more fluently — nothing else. Coverage,
# gaps, evidence, confidence and risk stay fully deterministic.
#
# Defaults per provider (applied automatically if you switch provider without
# changing the model):
#   anthropic   claude-sonnet-5
#   openai      gpt-4o-mini
#   gemini      gemini-3.6-flash            (gemini-2.x now 404s for new keys)
#   openrouter  nex-agi/nex-n2.5-mini:free  (free tier, ~5s per call)
#
# Picking an OpenRouter model: its free line-up changes often, and many free
# models are reasoning-first — they spend the entire token budget thinking,
# return an empty object and can take minutes. Prefer a small instruct model.
# List what your key can reach:
#   curl -H "Authorization: Bearer $KEY" https://openrouter.ai/api/v1/models
BLINDSPOT_LLM_PROVIDER=none
# BLINDSPOT_LLM_MODEL=nex-agi/nex-n2.5-mini:free
# BLINDSPOT_LLM_API_KEY=
BLINDSPOT_LLM_TIMEOUT_SECONDS=30

# Point any OpenAI-compatible gateway (OpenRouter, Together, vLLM, LM Studio,
# Ollama) at BlindSpot without new code. Leave unset to use the provider's own
# endpoint; "openrouter" already defaults to the right URL.
# BLINDSPOT_LLM_BASE_URL=http://localhost:11434/v1

# Embeddings. The default is a local, deterministic hashed TF-IDF model: no
# download, no network, and byte-identical vectors on every run.
BLINDSPOT_EMBEDDING_PROVIDER=hashed_tfidf
BLINDSPOT_EMBEDDING_MODEL=local-hashed-tfidf-v1
BLINDSPOT_EMBEDDING_DIMENSIONS=512

# Vector index: auto | faiss | numpy. "auto" uses FAISS when installed and
# falls back to an exact numpy store otherwise.
BLINDSPOT_VECTOR_STORE=auto

# ---------------------------------------------------------------- retrieval
BLINDSPOT_RETRIEVAL_TOP_K=15
BLINDSPOT_RETRIEVAL_MIN_SCORE=0.08
BLINDSPOT_RETRIEVAL_VECTOR_WEIGHT=0.5
BLINDSPOT_RETRIEVAL_LEXICAL_WEIGHT=0.5

# ---------------------------------------------------------------- analysis
# How many distinct incidents a gap family needs before it is reported as a
# recurring blind spot.
BLINDSPOT_PATTERN_MIN_INCIDENTS=3

# ---------------------------------------------------------------- ingestion limits
# Repository files are treated as untrusted input; these bound the damage a
# hostile or pathological tree can do.
BLINDSPOT_MAX_FILE_SIZE_BYTES=2000000
BLINDSPOT_MAX_SCANNED_FILES=20000
# Optional allow-list. When set, only directories under these roots may be
# indexed. Separate with the OS path separator (";" on Windows, ":" elsewhere).
# BLINDSPOT_ALLOWED_REPOSITORY_ROOTS=C:\Projects

# ---------------------------------------------------------------- frontend
BLINDSPOT_SERVE_FRONTEND=true
# BLINDSPOT_FRONTEND_DIR=./frontend
